{
  "name": "66qn-api",
  "version": "1.0.0",
  "description": "66qn Minecraft Server API - Cloudflare Workers",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute 66qn-db --file=./src/db/schema.sql",
    "db:seed": "wrangler d1 execute 66qn-db --file=./src/db/seed.sql",
    "db:reset": "wrangler d1 execute 66qn-db --file=./src/db/schema.sql && wrangler d1 execute 66qn-db --file=./src/db/seed.sql"
  },
  "dependencies": {
    "itty-router": "^4.0.0",
    "jose": "^5.0.0"
  },
  "devDependencies": {
    "wrangler": "^3.0.0"
  }
}
